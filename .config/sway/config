# swaybar with the rust status bar
bar {
    # apt install fonts-font-awesome (https://fontawesome.com/v4.7.0/assets/font-awesome-4.7.0.zip)
    # fc-list | grep awesome
    font pango:"CaskaydiaCove Nerd Font Mono", Mono 12, FontAwesome
    position bottom
    # Installed with `cargo install i3status-rs --features pipewire` (it is not
    # packaged for Ubuntu). The pipewire feature is what gives the privacy
    # block its mic/screen-share indicator. Explicit path because sway's PATH
    # has no ~/.cargo/bin. Reads .config/i3status-rust/config.toml
    status_command ~/.cargo/bin/i3status-rs
    colors {
        separator #666666
        background #222222
        statusline #dddddd
        focused_workspace #0088CC #0088CC #ffffff
        active_workspace #333333 #333333 #ffffff
        inactive_workspace #333333 #333333 #888888
        urgent_workspace #2f343a #900000 #ffffff
        #background          $bg
        #statusline          $fg
        #separator           $hi
        #focused_workspace   $gn        $bg        $ac
        #active_workspace    $gn        $ac        $tx
        #inactive_workspace  $bg        $bg        $ia
        #urgent_workspace    $rd        $bg        $ac
    }
}


# Volume Control
# i3status-rs polls on its own, so the i3status SIGUSR1 refresh is dropped.
bindsym --locked XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -- +5%
bindsym --locked XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -- -5%
bindsym --locked XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ -- toggle
bindsym $mod+Shift+plus exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +3%
bindsym $mod+Shift+minus exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -3%
bindsym $mod+Shift+m exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ -- toggle


# workspace assignment
# sway: [class=...] matches XWayland windows only, [app_id=...] matches native
# wayland windows. Both are listed so it works either way round.
# Use `swaymsg -t get_tree` to find the app_id / class of a running window.
assign [class="^(?i)slack"] 1
assign [app_id="^(?i)slack"] 1
assign [class="^(?i)sublime_merge"] 4
assign [app_id="^(?i)sublime_merge"] 4
assign [class="^(?i)google-chrome"] 5
assign [app_id="^(?i)google-chrome"] 5
assign [class="^(?i)firefox"] 6
assign [app_id="^(?i)firefox"] 6
assign [class="(?i)tresorit"] 8
assign [app_id="(?i)tresorit"] 8
assign [class="(?i)deskflow"] 8
assign [app_id="(?i)deskflow"] 8

# Output names differ from xrandr under sway (no "-1" connector suffix):
# xrandr eDP-1-1 -> sway eDP-1. Docked monitor names must be read off
# `swaymsg -t get_outputs` while docked; see ~/bin/sway-outputs.
set $laptopScreen eDP-1
set $mainScreen DP-1
set $rightScreen HDMI-A-1
workspace 3 output $mainScreen
workspace 4 output $mainScreen
workspace 5 output $rightScreen
workspace 6 output $rightScreen
workspace 8 output $laptopScreen
workspace 9 output $laptopScreen

# Switch monitor layout. xrandr does not drive wayland outputs; these are
# swaymsg reimplementations of the old ~/.screenlayout scripts.
# 3 monitor laptopScreen - mainScreen - rightScreen
bindsym $mod+y exec --no-startup-id "${HOME}/.screenlayout/main.sh"
# 2 monitor leftExtraScreen - laptopScreen
bindsym $mod+Shift+y exec --no-startup-id "${HOME}/.screenlayout/dual.sh"
# Single screen
bindsym Control+$mod+y exec --no-startup-id "${HOME}/.screenlayout/single.sh"

#bindsym $mod+u exec true || notify-send noooo

# Auto start programs. compton dropped: sway is its own compositor.
# nm-applet removed: network-manager-applet is not installed, so this was a
# dead exec inherited from the i3 config. Wifi is handled by a click action on
# the swaybar net block (nmtui / nm-connection-editor) instead of a tray daemon.

# Notification daemon. Nothing else provides org.freedesktop.Notifications
# under sway, so without this every notify-send is silently dropped.
# dunst rather than mako because i3status-rs's `notify` block (the DND toggle)
# only supports dunst and swaync.
exec --no-startup-id dunst

# Clipboard history. wl-clipboard alone keeps only the current selection.
# `--type text` so images are not stored; `cliphist wipe` (or
# `fuzzel-clipboard --wipe`) clears it if something sensitive is copied.
exec --no-startup-id wl-paste --type text --watch cliphist store

# Automount removable media. GNOME did this via gvfs; nothing does it under
# sway, so a USB stick would just sit there.
exec --no-startup-id udiskie --automount --notify --no-tray

# Lid: drop the internal panel when docked, lock when not. See ~/bin/sway-lid.
bindswitch --reload --locked lid:on exec ~/bin/sway-lid close
bindswitch --reload --locked lid:off exec ~/bin/sway-lid open

# Idle: lock after 10 min, screens off after 15, lock before sleep.
exec --no-startup-id swayidle -w \
        timeout 600 '~/bin/sway-lock' \
        timeout 900 'swaymsg "output * power off"' \
        resume 'swaymsg "output * power on"' \
        before-sleep '~/bin/sway-lock'
exec --no-startup-id tresorit
# deskflow cannot inject input under sway (no RemoteDesktop portal on wlroots),
# so waynergy replaces it as the keyboard/mouse-sharing client. It drives
# wlr-virtual-pointer + virtual-keyboard directly and syncs the clipboard via
# wl-clipboard. Config: ~/.config/waynergy/config.ini. See ~/README.md.
exec --no-startup-id "${HOME}/.local/bin/waynergy"
