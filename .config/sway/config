# Sway config, ported from ~/.config/i3/config
#
# IMPORTANT: this file existing is what stops sway falling back to
# ~/.config/i3/config. That fallback broke the xdg-desktop-portal stack,
# because /etc/sway/config.d/50-systemd-user.conf never got included.
# See "Window Manager Setup" in ~/README.md.

set $mod Mod4

### Environment for systemd user services and D-Bus activation.
### MUST stay first: xdg-desktop-portal-gtk exits with "cannot open display"
### if it is activated before WAYLAND_DISPLAY is in the systemd/dbus env.
exec_always systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
exec_always hash dbus-update-activation-environment 2>/dev/null && \
        dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP

font pango:"CaskaydiaCove Nerd Font Mono" Mono 12

# i3's `title_window_icon` has no sway equivalent (sway draws no window icons).
#for_window [all] title_window_icon padding 1px

# Repeating this workspace number jumps back to the previous workspace
workspace_auto_back_and_forth yes

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# Keyboard layout. sway defaults every keyboard to us and does not read
# /etc/default/keyboard, so the built-in GB keyboard was typing us.
# Set by device identifier ON PURPOSE: `input type:keyboard xkb_layout gb`
# would also capture waynergy's wlr_virtual_keyboard_v1 and override the
# us keymap that decodes scancodes from the Windows server, breaking
# remote input. Keep this scoped to the one physical device.
# `swaymsg -t get_inputs` lists identifiers.
input "1:1:AT_Translated_Set_2_keyboard" xkb_layout gb

# Touchpad. Sway applies no touchpad defaults at all, so without this there is
# no tap-to-click, no natural scrolling and no disable-while-typing.
# `type:touchpad` rather than the device id so it survives new hardware; unlike
# `type:keyboard` this cannot catch waynergy's virtual device, which registers
# as a pointer.
input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
    middle_emulation enabled
    click_method clickfinger
    scroll_method two_finger
}

# Cursor. Nothing sets this by default, so you get the fallback theme at the
# fallback size - noticeably small on a 4K output, and XWayland apps disagree
# with native ones unless it is set explicitly here.
seat seat0 xcursor_theme Adwaita 24

# Window rules. There were none, so every settings dialog tiled into the
# layout. `class` matches XWayland, `app_id` native wayland - hence both.
for_window [app_id="pavucontrol"] floating enable, resize set 900 600
for_window [app_id="blueman-manager"] floating enable, resize set 800 600
for_window [app_id="nm-connection-editor"] floating enable, resize set 800 600
for_window [app_id="gsimplecal"] floating enable
for_window [app_id="org.gnome.Nautilus"] floating enable, resize set 1000 700
for_window [class="Pavucontrol"] floating enable
for_window [class="Blueman-manager"] floating enable
for_window [class="Nm-connection-editor"] floating enable
for_window [window_role="pop-up|bubble|dialog|menu|task_dialog"] floating enable
# window_type takes an enum, not a regex (unlike window_role), so these
# cannot be collapsed into one alternation.
for_window [window_type="dialog"] floating enable
for_window [window_type="menu"] floating enable
for_window [window_type="splash"] floating enable

# start a terminal
bindsym $mod+g exec wezterm

# kill focused window
bindsym $mod+Shift+Delete kill

# launchers. dmenu_run still works via XWayland; wofi is the native one.
bindsym $mod+t exec dmenu_run
# i3-dmenu-desktop talks i3 IPC and does not work under sway -> wofi
bindsym $mod+d exec --no-startup-id fuzzel

# Command palette: wifi / audio / clipboard / screenshots / displays / keys /
# power, all behind one key instead of scattered bar clicks.
bindsym $mod+BackSpace exec --no-startup-id ~/bin/fuzzel-menu
bindsym $mod+Shift+v exec --no-startup-id ~/bin/fuzzel-clipboard
bindsym $mod+Tab exec --no-startup-id ~/bin/fuzzel-windows
bindsym $mod+e exec --no-startup-id ~/bin/fuzzel-emoji
# Screenshot menu. PrtSc is bound too, but it is an awkward reach on the
# Glove80; Shift+P for "print".
bindsym $mod+Shift+p exec --no-startup-id ~/bin/fuzzel-screenshot

# Scratchpad: a window parked off-layout that you summon and dismiss.
# $mod+minus / $mod+Shift+minus is the i3 convention, but Shift+minus is
# already volume-down here, so both live on u.
bindsym $mod+u scratchpad show
bindsym $mod+Shift+u move scratchpad
# To take a window back OUT of the scratchpad: summon it with $mod+u, then
# $mod+Shift+BackSpace (floating toggle) tiles it into the current workspace.
# There is no separate "remove from scratchpad" command in sway.

# change focus
#bindsym $mod+n focus left
bindsym $mod+s focus down
bindsym $mod+f focus up
#bindsym $mod+o focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
#bindsym $mod+Shift+n move left
bindsym $mod+Shift+s move down
bindsym $mod+Shift+f move up
#bindsym $mod+Shift+o move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+Home move workspace to output left
bindsym $mod+End move workspace to output right
bindsym Control+$mod+s move workspace to output up
bindsym Control+$mod+f move workspace to output down

# split in horizontal orientation
bindsym $mod+h split h

# split in vertical orientation
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+p fullscreen

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+r layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+b layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+BackSpace floating toggle

# change focus between tiling / floating windows.
# On $mod+space (the i3/sway default for this) rather than $mod+BackSpace:
# BackSpace is easier to reach on the Glove80, so the command palette has it.
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

# focus the child container
bindsym $mod+c focus child

# switch to workspace
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10
bindsym Control+$mod+1 workspace 11
bindsym Control+$mod+2 workspace 12
bindsym Control+$mod+3 workspace 13
bindsym Control+$mod+4 workspace 14
bindsym Control+$mod+5 workspace 15
bindsym Control+$mod+6 workspace 16
bindsym Control+$mod+7 workspace 17
bindsym Control+$mod+8 workspace 18
bindsym Control+$mod+9 workspace 19
bindsym Control+$mod+0 workspace 20

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10
bindsym Control+$mod+Shift+1 move container to workspace 11
bindsym Control+$mod+Shift+2 move container to workspace 12
bindsym Control+$mod+Shift+3 move container to workspace 13
bindsym Control+$mod+Shift+4 move container to workspace 14
bindsym Control+$mod+Shift+5 move container to workspace 15
bindsym Control+$mod+Shift+6 move container to workspace 16
bindsym Control+$mod+Shift+7 move container to workspace 17
bindsym Control+$mod+Shift+8 move container to workspace 18
bindsym Control+$mod+Shift+9 move container to workspace 19
bindsym Control+$mod+Shift+0 move container to workspace 20

# reload the configuration file
bindsym $mod+Shift+c reload
# i3's $mod+Shift+z "restart in place" is not ported: sway has no equivalent
# (the compositor is the display server, so re-executing it would tear down
# every client) and mapping it to reload just duplicated $mod+Shift+c.
# exit sway
# Power menu overlay (lock/logout/suspend/reboot/shutdown). No hibernate entry:
# `loginctl can-hibernate` is "no" here (4G swap vs 14G RAM), so it would fall
# through to a plain shutdown and lose the session.
bindsym $mod+Shift+x exec wlogout -b 3

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window's width.
        # Pressing right will grow the window's width.
        # Pressing up will shrink the window's height.
        # Pressing down will grow the window's height.
        bindsym n resize shrink width 10 px or 10 ppt
        bindsym e resize grow height 10 px or 10 ppt
        bindsym i resize shrink height 10 px or 10 ppt
        bindsym o resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape
        bindsym Return mode "default"
        bindsym Escape mode "default"
}

bindsym $mod+j mode "resize"

# lock computer ctrl alt l  (i3lock -> swaylock)
bindsym Control+mod1+l exec ~/bin/sway-lock
bindsym Control+Shift+mod1+l exec ~/bin/sway-lock && systemctl suspend

# screenshots (X11 had none; grim+slurp are the wayland pair)
bindsym Print exec grim - | wl-copy
bindsym Shift+Print exec grim -g "$(slurp)" - | wl-copy

# Brightness and media keys (--locked so they work on the lock screen)
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous


# Colouring and Styling
# xsetroot/compton are X11-only. sway composites itself and sets its own bg.
exec_always --no-startup-id ~/bin/random_background.sh

