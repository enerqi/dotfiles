# Display profiles, applied automatically on hotplug.
#
# kanshi matches on output *name* (eDP-1, DP-3) or on "make model serial",
# which is the more robust key: DP-N numbering moves around between docks and
# reboots, the monitor's identity does not. Run `~/bin/sway-outputs` while
# docked to read both off the live outputs.
#
# The manual $mod+y / $mod+Shift+y / Ctrl+$mod+y layouts still work and
# override whatever kanshi last applied, until the next hotplug.

profile laptop {
    output eDP-1 enable mode 1920x1200@60.003Hz position 0,0 scale 1 transform normal
}

# Docked profiles: do not hand-write these. Dock, arrange the monitors in
# wdisplays (palette -> Display layout -> Arrange...), press Apply, then
# Display layout -> Save current layout. ~/bin/sway-save-layout writes the
# profile below, keyed on each monitor's make/model/serial, validates it with
# kanshi's own parser first, and makes kanshi reload. It replaces an existing
# profile for the same monitors rather than adding a second copy.
#
