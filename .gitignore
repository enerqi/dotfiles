# For now ignoring any file or directory that does not start with a "."
# Any dot sub-directory must be explicitly re-included
*
!\.*

# exclude git subprojects as they have their own ignore file
# .oh-my-zsh/custom files have to be force added to this dotfiles config repo
.oh-my-zsh
.zprezto

!bin/
!bin/**
# 24MB build artefact - installed with `cargo install i3status-rs --features pipewire`
bin/i3status-rs

!cmder/
!cmder/**
!cmder/config
cmder/*.md
cmder/icons/
cmder/vendor/
cmder/Version*
cmder/Cmder.exe

!.config/alacritty/
!.config/alacritty/**
!.config/terminator/
!.config/terminator/**
!.config/starship.toml
!.config/i3status-rust/
!.config/i3status-rust/**
!.config/i3/
!.config/i3/**
!.config/sway/
!.config/sway/**
!.config/waynergy/
!.config/waynergy/config.ini
!.config/waynergy/xkb_keymap
.config/waynergy/tls/
!.config/xkb/
!.config/xkb/**
!.config/wlogout/
!.config/wlogout/**
!.config/kanshi/
!.config/kanshi/**
!.config/foot/
!.config/foot/**
!.config/fuzzel/
!.config/fuzzel/**

# Desktop-entry overrides. Only the two hand-written ones: btop.desktop fixes
# the packaged Terminal=true entry (cramped window, wrong app_id) and
# waynergy.desktop fixes the /usr/bin path `ninja install` bakes in. The other
# files here are generated by Claude Code and Tresorit, hardcode an absolute
# home path, and are recreated by those installers - tracking them is churn.
# Each parent dir needs re-including for git to descend into it.
!.local/share/
!.local/share/applications/
!.local/share/applications/btop.desktop
!.local/share/applications/waynergy.desktop

!README.md
!KEYMAP.md
!.config/wezterm/
!.config/wezterm/**
!.config/wezterm/wezterm-session-manager/
!.config/wezterm/wezterm-session-manager/**

!.i3/config
!.i3/**

!.screenlayout/
!.screenlayout/**
.screenlayout/*.x11.bak

!.lein/
!.lein/**
.lein/self-installs/

.cargo/

.bash_history

# Credentials and machine-local state. The `!\.*` rule above re-includes every
# dotfile in $HOME, so anything secret here must be excluded explicitly or a
# `git add -A` will stage it.
.vault-token
.claude/
.claude.json
.netrc
.npmrc
.aws/
.ssh/
.gnupg/
.docker/config.json
.sudo_as_admin_successful
.wget-hsts
.zshrc.zwc
.bash_logout

.dmenu_cache
.gitconfig
.gtk*
.install4j
.k_history
.lesshst
.pgadmin_histo*
.pgpass
.pythonhist
.rc.local
.recently-used
.rnd
.SpiderOak
.swinfo
.viminfo
.zcompdump*
.zsh-update
.zshrc.local
.zprofile.local
.zgenom/

*authority
*cookie*
*errors*
*history
*_hist
*.lock
*.log
*.pid

.agents
.aider*
.claude
.claude-work


