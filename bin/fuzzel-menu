#!/bin/bash
# Command palette - one keybind ($mod+BackSpace) reaching the things that otherwise
# live in scattered bar clicks or keybinds nobody remembers.
#
# Each entry just calls the tool that already does the job, so there is one
# implementation of each action, not two.
set -uo pipefail

FUZZEL=(fuzzel --dmenu --width 40 --lines 14 --no-exit-on-keyboard-focus-loss)
BIN="$HOME/bin"

# Do-not-disturb shows its current state rather than making you toggle it to
# find out. The label keeps the words "Do not disturb" in both cases so typing
# them always matches, whichever way it is currently set.
if [ "$(dunstctl is-paused 2>/dev/null)" = "true" ]; then
    dnd_state="[on]"
else
    dnd_state="[off]"
fi

entries=(
    "  Wi-Fi"
    "  Audio output"
    "  Clipboard history"
    "  Removable media"
    "  Bluetooth"
    "  VPN"
    "  Windows"
    "  Emoji / characters"
    "  Power profile"
    "  System monitor"
    "  Calculator"
    "  Record screen"
    "  Colour picker"
    "  Night light"
    "  Notifications"
    "  Do not disturb  $dnd_state"
    "  Calendar"
    "  Containers"
    "  Updates"
    "  Screenshot"
    "  Display layout"
    "  Keybindings"
    "  Lock"
    "  Power menu"
)

choice=$(printf '%s\n' "${entries[@]}" | "${FUZZEL[@]}" --prompt "> ") || exit 0

case "$choice" in
    *"Wi-Fi")                "$BIN/fuzzel-wifi" ;;
    *"Audio output")         "$BIN/fuzzel-audio" ;;
    *"Clipboard history")    "$BIN/fuzzel-clipboard" ;;
    *"Removable media")     "$BIN/fuzzel-media" ;;
    *"VPN")                  "$BIN/fuzzel-vpn" ;;
    *"Windows")              "$BIN/fuzzel-windows" ;;
    *"Emoji / characters")   "$BIN/fuzzel-emoji" ;;
    *"Power profile")        "$BIN/fuzzel-power-profile" ;;
    *"System monitor")
        # Wrapper, not an inline foot command: the btop++ launcher entry
        # calls the same script, so the two cannot drift apart.
        "$BIN/btop-term" & ;;
    *"Calculator")           "$BIN/fuzzel-calc" ;;
    *"Record screen")        "$BIN/fuzzel-record" ;;
    *"Night light")          "$BIN/sway-nightlight" ;;
    *"Notifications")        dunstctl history-pop ;;
    *"Do not disturb"*)      dunstctl set-paused toggle ;;
    *"Calendar")             gsimplecal & ;;
    *"Containers")
        # Same scripts the bar's docker and packages modules open, so the
        # palette and the bar cannot show different things.
        "$BIN/waybar-docker-ps" & ;;
    *"Updates")              "$BIN/waybar-packages-list" & ;;
    *"Colour picker")
        if command -v hyprpicker >/dev/null; then
            hyprpicker -a   # -a copies straight to the clipboard
        else
            command -v notify-send >/dev/null &&
                notify-send -a menu "hyprpicker not installed"
        fi ;;
    *"Bluetooth")
        if command -v blueman-manager >/dev/null; then
            blueman-manager &
        else
            command -v notify-send >/dev/null &&
                notify-send -a menu "Bluetooth" "blueman not installed"
        fi ;;
    *"Screenshot")           "$BIN/fuzzel-screenshot" ;;
    *"Display layout")
        layout=$(printf '%s\n' "3 monitors (main)" "2 monitors (dual)" "Laptop only (single)" |
                 "${FUZZEL[@]}" --prompt "display> ") || exit 0
        case "$layout" in
            "3 monitors (main)")     "$HOME/.screenlayout/main.sh" ;;
            "2 monitors (dual)")     "$HOME/.screenlayout/dual.sh" ;;
            "Laptop only (single)")  "$HOME/.screenlayout/single.sh" ;;
        esac ;;
    *"Keybindings")          "$BIN/sway-keys" ;;
    *"Lock")                 "$BIN/sway-lock" ;;
    *"Power menu")           wlogout -b 3 ;;
esac
