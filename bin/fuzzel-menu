#!/usr/bin/env python3
"""Command palette - one keybind ($mod+BackSpace) reaching the things that
otherwise live in scattered bar clicks or keybinds nobody remembers.

Each entry calls the tool that already does the job, so there is one
implementation of each action rather than two. The bar's click actions and the
keybinds go through these same scripts.

Ported from bash in 2026-09. The bash version kept every entry twice - once as
a label in an `entries=()` array and once as a glob in a `case` block - and the
two had to be edited together. A label with no arm silently did nothing when
selected; an arm with no label was dead code. Here an entry is one object that
carries its own action, so the two cannot disagree.

Python rather than shell for the same reason the other ~/bin scripts that
needed a data structure are Python: the startup cost (~19ms against bash's
~2ms) is invisible on a keypress, and fuzzel takes longer than that to draw.
The waybar pollers stay in shell because they run every few seconds forever.
"""

import shutil
import subprocess
import sys

HOME = __import__("os").path.expanduser("~")
BIN = f"{HOME}/bin"
FUZZEL = [
    "fuzzel",
    "--dmenu",
    "--width",
    "40",
    "--lines",
    "14",
    "--no-exit-on-keyboard-focus-loss",
]


def notify(summary, body=""):
    if shutil.which("notify-send"):
        # check=False: a notification that fails is not worth an exception.
        subprocess.run(["notify-send", "-a", "menu", summary, body], check=False)


def pick(items, prompt):
    """Show fuzzel and return the chosen item's POSITION, or None if cancelled.

    Position, via fuzzel --index, never the text. Matching text back is what
    broke this palette when it was first ported: every label starts with two
    spaces, and stripping fuzzel's output to lose the trailing newline also
    lost those, so no label ever matched and all 26 entries silently did
    nothing. An index cannot drift from the label it came from.
    """
    # check=False is load-bearing: fuzzel exits non-zero when the menu is
    # dismissed with Escape, which is a normal outcome, not an error.
    proc = subprocess.run(
        FUZZEL + ["--index", "--prompt", prompt],
        input="\n".join(items),
        capture_output=True,
        text=True,
        check=False,
    )
    if proc.returncode != 0:
        return None
    try:
        index = int(proc.stdout.strip())
    except ValueError:
        return None
    # fuzzel prints -1 when Enter is pressed on typed text that matches no
    # entry; treat that, and anything else out of range, as no selection.
    return index if 0 <= index < len(items) else None


def run(*cmd):
    """Run and wait. For tools that draw their own menu - the palette should
    not return until they are finished with the screen."""
    # check=False: these tools exit non-zero for ordinary reasons - a menu
    # dismissed, nothing selected - and the palette has already gone.
    return lambda: subprocess.run(list(cmd), check=False)


def spawn(*cmd):
    """Start detached and return immediately, for anything that opens a window.

    start_new_session is what `&` gave us in bash: the child gets its own
    session, so it is not tied to this process and does not receive signals
    aimed at the palette. Without it a spawned window can die with its parent.
    """
    return lambda: subprocess.Popen(
        list(cmd),
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def optional(binary, *cmd, missing=""):
    """Spawn a tool that may not be installed, saying so rather than failing
    silently."""

    def action():
        if not shutil.which(binary):
            notify(missing or f"{binary} not installed")
            return
        subprocess.Popen(
            list(cmd) or [binary],
            start_new_session=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

    return action


def display_layout():
    """Submenu: arrange visually, save what is on screen, or a fixed preset.

    Arrange opens wdisplays, which drags monitors around live but only for
    this session. Save writes the result as a kanshi profile, after which
    kanshi re-applies it on every hotplug of that monitor set - so the usual
    order is Arrange, Apply, then Save. The three presets are the older
    swaymsg reimplementations of the xrandr scripts; they run once and are
    overridden by kanshi at the next plug event.
    """
    layouts = {
        "Arrange... (visual)": spawn("wdisplays"),
        "Save current layout": run(f"{BIN}/sway-save-layout"),
        "3 monitors (main)": run(f"{HOME}/.screenlayout/main.sh"),
        "2 monitors (dual)": run(f"{HOME}/.screenlayout/dual.sh"),
        "Laptop only (single)": run(f"{HOME}/.screenlayout/single.sh"),
    }
    names = list(layouts)
    index = pick(names, "display> ")
    if index is not None:
        layouts[names[index]]()


def dnd_state():
    """[on] / [off] so the entry says what it will do. Both labels keep the
    words "Do not disturb" so typing them always matches."""
    # check=False so a missing or unhappy dunstctl degrades to "[off]"
    # rather than stopping the whole palette from opening.
    proc = subprocess.run(
        ["dunstctl", "is-paused"], capture_output=True, text=True, check=False
    )
    return "[on]" if proc.stdout.strip() == "true" else "[off]"


# The palette, in display order - deliberately not alphabetical.
#
# Labels are two spaces then text, with no icon: fuzzel's own font would have
# to carry the glyph and the list reads as a column of words without them.
# (Two entries briefly had Nerd Font glyphs; they were the odd ones out.)
#
# Where an entry calls a ~/bin wrapper rather than the tool directly, that is
# deliberate and the comment says why - those wrappers exist so the palette and
# the bar cannot drift apart.
ENTRIES = [
    ("  Wi-Fi", run(f"{BIN}/fuzzel-wifi")),
    ("  Audio output", run(f"{BIN}/fuzzel-audio")),
    ("  Clipboard history", run(f"{BIN}/fuzzel-clipboard")),
    # Saves the clipboard image and leaves its PATH on the clipboard, for
    # Claude Code and friends, which take a path rather than pixels. --pick so
    # an image copied a while ago is still reachable.
    ("  Image to file (copies path)", spawn(f"{BIN}/clip-image-path", "--pick")),
    ("  Removable media", run(f"{BIN}/fuzzel-media")),
    # Wrapper, not an inline foot command: $mod+Shift+e uses the same one, and
    # its single-instance guard only works if both go through it.
    ("  Files", spawn(f"{BIN}/yazi-term")),
    ("  Bluetooth", optional("blueman-manager", missing="blueman not installed")),
    ("  VPN", run(f"{BIN}/fuzzel-vpn")),
    ("  Windows", run(f"{BIN}/fuzzel-windows")),
    ("  Emoji / characters", run(f"{BIN}/fuzzel-emoji")),
    ("  Power profile", run(f"{BIN}/fuzzel-power-profile")),
    # Wrapper, not an inline foot command: the btop++ launcher entry calls the
    # same script, so the two cannot drift apart.
    ("  System monitor", spawn(f"{BIN}/btop-term")),
    ("  Calculator", run(f"{BIN}/fuzzel-calc")),
    ("  Record screen", run(f"{BIN}/fuzzel-record")),
    # -a copies straight to the clipboard.
    ("  Colour picker", optional("hyprpicker", "hyprpicker", "-a")),
    ("  Night light", run(f"{BIN}/sway-nightlight")),
    ("  Notifications", run("dunstctl", "history-pop")),
    ("  Do not disturb", run("dunstctl", "set-paused", "toggle")),
    ("  Calendar", spawn("gsimplecal")),
    # Same scripts the bar's docker and packages modules open, so the palette
    # and the bar cannot show different things.
    ("  Containers", spawn(f"{BIN}/waybar-docker-ps")),
    ("  Updates", spawn(f"{BIN}/waybar-packages-list")),
    ("  Screenshot", run(f"{BIN}/fuzzel-screenshot")),
    ("  Display layout", display_layout),
    ("  Keybindings", run(f"{BIN}/sway-keys")),
    ("  Lock", run(f"{BIN}/sway-lock")),
    ("  Power menu", spawn("wlogout", "-b", "3")),
]


def labels():
    """Display labels, with the DND state appended to its entry only."""
    out = []
    for label, _ in ENTRIES:
        if label.strip() == "Do not disturb":
            label = f"{label}  {dnd_state()}"
        out.append(label)
    return out


def main():
    if not shutil.which("fuzzel"):
        sys.stderr.write("fuzzel not found\n")
        return 1

    shown = labels()

    if "--list" in sys.argv[1:]:
        print("\n".join(shown))
        return 0

    # By position. The bash version matched with suffix globs like *"Files"),
    # so a future label ending in the same words would have run the wrong
    # thing; the first Python version matched the text and matched nothing.
    index = pick(shown, "> ")
    if index is None:
        return 0
    ENTRIES[index][1]()
    return 0


if __name__ == "__main__":
    sys.exit(main())
