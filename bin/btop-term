#!/bin/sh
# btop in a correctly-sized foot window.
#
# One place for this invocation, used by both the command palette and the
# btop++ launcher entry, which otherwise drift apart and behave differently.
#
# Sizing is in CHARACTERS: btop refuses to draw below 80x24, and foot runs
# dpi-aware here, so cells are ~16x34px at size 12 - 80 columns alone would
# need 1280px and the window ends up nearly fullscreen. Size 9 fits the same
# grid into about two thirds of the screen.
#
# --title is separate from --app-id and both are needed: app_id is what the
# sway `for_window` rule matches on, title is what waybar's window module
# displays. Without it the bar said "foot" for every one of these windows.
#
# app_id=btop so the sway rule (`for_window [app_id="btop"] floating enable`)
# matches. Do NOT add a pixel `resize set` to that rule: it overrides the
# character sizing and puts btop back under its minimum.
# Single instance. The bar has five modules that open btop (cpu, load, memory,
# temperature, disk); clicking two of them stacked two identical windows on top
# of each other. If one is already open, focus it instead.
#
# `swaymsg ... focus` exits 2 with "No matching node." when nothing matches,
# so the exit status is the test - no tree parsing needed.
#
# Only when called with no arguments: `btop-term --some-flag` is asking for a
# specifically configured btop, so it gets its own window.
if [ $# -eq 0 ] && command -v swaymsg >/dev/null 2>&1; then
    if swaymsg '[app_id="btop"] focus' >/dev/null 2>&1; then
        exit 0
    fi
fi

exec foot \
    --app-id=btop \
    --title=btop \
    --font="CaskaydiaCove Nerd Font Mono:size=9" \
    --window-size-chars=110x32 \
    -e btop "$@"
