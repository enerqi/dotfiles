#!/bin/sh
# Upgradable package list for the waybar packages module.
#
# `apt list --upgradable` prints "name/suite version arch [upgradable from: x]"
# which runs past 100 columns for no benefit - the suite, arch and old version
# are noise when the question is "what is waiting". Name plus new version only.
#
# Read-only on purpose: a bar click should not start something that asks for a
# password and mutates the system.
exec foot \
    --app-id=waybar-popup \
    --title=updates \
    --font="CaskaydiaCove Nerd Font Mono:size=9" \
    --window-size-chars=96x30 \
    -e sh -c 'apt list --upgradable 2>/dev/null \
        | awk -F"[/ ]" "NR>1 { printf \"%-45s %s\n\", \$1, \$3 }" \
        | less -S -~'
