#!/bin/bash
# Audio output switcher + quick volume, using fuzzel so it matches the
# launcher. pavucontrol is still the right tool for per-application mixing;
# this is for the common case of "put the sound somewhere else".
#
# PipeWire with the PulseAudio compat layer, so pactl works and gives JSON,
# which is far less fragile to parse than `wpctl status` tree output.
set -uo pipefail

# --no-exit-on-keyboard-focus-loss: sway defaults to focus_follows_mouse, so
# moving the pointer towards the menu focuses whatever is underneath it and
# fuzzel would exit before you reach it. Escape still dismisses.
FUZZEL=(fuzzel --dmenu --width 60 --no-exit-on-keyboard-focus-loss)

list_sinks() {
    pactl -f json list sinks 2>/dev/null | python3 -c '
import json, sys
default = sys.argv[1]
try:
    sinks = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for s in sinks:
    name = s.get("name", "")
    desc = s.get("description") or name
    vol = s.get("volume") or {}
    # Average the per-channel percentages, e.g. "86%" -> 86
    pcts = []
    for ch in vol.values():
        p = str(ch.get("value_percent", "")).rstrip("%")
        if p.isdigit():
            pcts.append(int(p))
    avg = round(sum(pcts) / len(pcts)) if pcts else 0
    muted = " [muted]" if s.get("mute") else ""
    mark = "● " if name == default else "  "
    print(f"{mark}{desc} — {avg}%{muted}\t{name}")
' "$(pactl get-default-sink 2>/dev/null)"
}

sinks=$(list_sinks)
if [[ -z "$sinks" ]]; then
    command -v notify-send >/dev/null && notify-send -a audio "No audio sinks found"
    exit 1
fi

# No volume entries: adjusting by 5% takes several presses, and re-opening
# fuzzel per step flashed the window. Volume is scroll-wheel on the swaybar
# sound block instead (step_width there). This menu is for the things that
# are genuinely one-shot.
choice=$(
    { cut -f1 <<<"$sinks"
      printf '%s\n' "─────" "Toggle mute" "Open mixer (pavucontrol)"
    } | "${FUZZEL[@]}" --prompt "audio> "
) || exit 0

case "$choice" in
    ""|"─────")
        exit 0 ;;
    "Toggle mute")
        pactl set-sink-mute @DEFAULT_SINK@ toggle; exit 0 ;;
    "Open mixer (pavucontrol)")
        pavucontrol & exit 0 ;;
esac

# Recover the sink name from the hidden tab-separated second field.
sink=$(awk -F'\t' -v c="$choice" '$1 == c {print $2; exit}' <<<"$sinks")
[[ -z "$sink" ]] && exit 0

pactl set-default-sink "$sink"

# Move anything already playing, otherwise existing streams stay on the old
# sink and it looks like the switch did nothing.
pactl -f json list sink-inputs 2>/dev/null |
    python3 -c 'import json,sys;[print(i["index"]) for i in json.load(sys.stdin)]' 2>/dev/null |
    while read -r idx; do pactl move-sink-input "$idx" "$sink"; done

command -v notify-send >/dev/null &&
    notify-send -a audio "Output" "$(awk -F'\t' -v s="$sink" '$2==s{sub(/^../,"",$1); print $1; exit}' <<<"$sinks")"
exit 0
