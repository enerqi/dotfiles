#!/bin/bash
# VPN menu.
#
# Two unrelated VPNs live here: Surfshark (personal, its own GUI) and a work
# OpenVPN profile driven by ~/vpn-gc.sh, which is a symlink to a script
# outside this repo - nothing about the employer belongs in dotfiles.
#
# The work one cannot be launched straight from a menu: it needs sudo *and*
# openvpn prompts for a username and password (the profile carries inline
# certs plus auth-user-pass). Both need a terminal, so this opens one rather
# than pretending otherwise.
#
# That terminal runs ~/bin/vpn-work-connect, which starts openvpn with
# `--daemon --log-append`: it asks for credentials, detaches, and logs to a
# file itself. The window closes on its own once connected and stays open,
# showing why, if not. "Show work VPN log" follows the file afterwards - it
# keeps recording drops and reconnects with no window open. This needs the
# work script to forward "$@" to openvpn; it does as of 2026-09.
#
# **Closing a window never disconnects.** Before the daemon change openvpn ran
# in the foreground, and closing its window still left tun0 up (sudo was
# reparented to PID 1) - an earlier version of this comment claimed the
# opposite. Disconnect from this menu, which appears whenever a tunnel is up;
# the bar's VPN module shows the tunnel either way.
set -uo pipefail

FUZZEL=(fuzzel --dmenu --width 46 --no-exit-on-keyboard-focus-loss)
TERM_CMD=(foot)
WORK_SCRIPT="$HOME/vpn-gc.sh"
# openvpn writes this itself, as root, into a file vpn-work-connect creates
# first so it stays the user's own and readable without sudo.
WORK_LOG="${XDG_STATE_HOME:-$HOME/.local/state}/vpn-work.log"

notify() { command -v notify-send >/dev/null && notify-send -a vpn "$@"; }

tunnel_iface() {
    ip -o link show 2>/dev/null |
        awk -F': ' '$2 ~ /^(tun|wg|nordlynx|surfshark)[0-9]*$/ {print $2; exit}'
}

iface=$(tunnel_iface)
if [[ -n "$iface" ]]; then
    status="● connected ($iface)"
else
    status="○ not connected"
fi

entries=("$status" "─────")
if [[ -n "$iface" ]]; then
    entries+=("Disconnect work VPN")
else
    entries+=("Connect work VPN")
fi
entries+=("Surfshark" "Show tunnel details")
# Offered whenever there is a log, connected or not - after a drop is exactly
# when it is wanted.
[[ -s "$WORK_LOG" ]] && entries+=("Show work VPN log")

choice=$(printf '%s\n' "${entries[@]}" | "${FUZZEL[@]}" --prompt "vpn> ") || exit 0

case "$choice" in
    "Connect work VPN")
        if [[ ! -e "$WORK_SCRIPT" ]]; then
            notify "Not found" "${WORK_SCRIPT/#$HOME/\~}"
            exit 1
        fi
        # Positional arguments rather than interpolating into a bash -c string:
        # nothing here gets re-parsed by a shell.
        "${TERM_CMD[@]}" --app-id=vpn-work --title="work VPN" \
            -e "$HOME/bin/vpn-work-connect" "$WORK_SCRIPT" "$WORK_LOG" &
        ;;
    "Disconnect work VPN")
        # sudo again, so again a terminal. SIGINT lets openvpn tear the route
        # table down properly instead of leaving a stale default route.
        "${TERM_CMD[@]}" -e bash -c "sudo pkill -INT openvpn; sleep 1; echo 'disconnected'; sleep 1" &
        ;;
    "Surfshark")
        if command -v surfshark >/dev/null; then surfshark & else notify "surfshark not installed"; fi
        ;;
    "Show work VPN log")
        "${TERM_CMD[@]}" --app-id=vpn-log --title="work VPN log" \
            -e tail -n 200 -f "$WORK_LOG" &
        ;;
    "Show tunnel details")
        if [[ -z "$iface" ]]; then
            notify "No tunnel up"
        else
            "${TERM_CMD[@]}" -e bash -c "ip addr show '$iface'; echo; ip route | grep -E '$iface|default'; echo; read -rp 'enter to close '" &
        fi
        ;;
esac
