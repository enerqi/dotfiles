# Sway output names for the layout scripts. Sway names differ from xrandr:
# no trailing connector index (xrandr eDP-1-1 -> sway eDP-1), and DVI-I-x-y
# docked outputs usually come back as DP-N / HDMI-A-N.
#
# Run `~/bin/sway-outputs` WHILE DOCKED and paste the real names here.
LAPTOP=eDP-1
MAIN=DP-1        # was xrandr DVI-I-3-2, 3840x2160
RIGHT=DP-2       # was xrandr DVI-I-2-1, 1920x1080
DUAL_EXT=HDMI-A-1  # was xrandr HDMI-1-2, 1920x1080
